# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# O firmware do no e exercicio: firmware/ guarda so o roteiro, e o projeto que cada
# aluno escreve ali fica na maquina dele. Sem isto, o primeiro `git add -A` de quem
# estiver seguindo o roteiro empurraria o sketch pessoal -- e o gabarito -- para o
# repositorio que os proximos alunos vao clonar.
firmware/*
!firmware/ROTEIRO.md

# Propostas ainda nao submetidas aos editais de 2026. Sao a fonte de requisitos de
# todo o codigo, mas ficam apenas na maquina local, fora do controle de versao.
propostas/

# Segredos e estado local
deploy/.env
deploy/mosquitto.passwd
*.sqlite3

# Sistema
.DS_Store

# Banco de desenvolvimento local
meliponet-dev.sqlite3*
meliponet.sqlite3*
